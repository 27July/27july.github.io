---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Zi Hao Wee",
  description = "Personal project portfolio for Zi Hao Wee.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/derpyPsyduck.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body>
    <main class="min-h-screen text-[#ECEFF4]">
      <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
        <slot />
      </div>
    </main>
  </body>
</html>
